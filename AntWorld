local Zynz = loadstring(game:HttpGet(
    "https://raw.githubusercontent.com/ttheurus-art/Creator/refs/heads/main/Zynz.luau"
))()

local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer

local Window = Zynz:CreateWindow({
    Name = "Dirt Controller",
    MainTabTheme = "Modern"
})

local MainTab = Window:CreateTab({
    Name = "Main"
})

local EspTab = Window:CreateTab({
    Name = "Esp"
})

-- MAIN

local RunningBuild = false

MainTab:CreateButton({
    Name = "Get rid of dirt",
    Callback = function()
        RunningBuild = not RunningBuild

        if RunningBuild then
            task.spawn(function()
                while RunningBuild do
                    local Character = LocalPlayer.Character
                    local Root = Character and Character:FindFirstChild("HumanoidRootPart")
                    local Build = Character and Character:FindFirstChild("Build")
                    local Event = Build and Build:FindFirstChild("RemoteEvent")

                    if Root and Event then
                        Event:FireServer(Root.Position + Vector3.new(0, 50, 0))
                    end

                    task.wait(0.0001)
                end
            end)
        end
    end
})

local RunningDig = false

MainTab:CreateButton({
    Name = "Get Dirt",
    Callback = function()
        RunningDig = not RunningDig

        if RunningDig then
            task.spawn(function()
                while RunningDig do
                    local Character = LocalPlayer.Character
