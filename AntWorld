-- ESP LOOP

task.spawn(function()
    while task.wait(0.25) do
        for _, Target in ipairs(Players:GetPlayers()) do
            if Target ~= LocalPlayer then
                GreenESP(Target)
                GhostESP(Target)
                GoldESP(Target)
                PurpleESP(Target)
                CopperESP(Target)
            end
        end
    end
end)
