local RunningHatch = false

MainTab:CreateButton({
    Name = "Get Hatch (Egg)",
    Callback = function()
        RunningHatch = not RunningHatch

        if RunningHatch then
            task.spawn(function()
                while RunningHatch do
                    local PlayerGui = LocalPlayer:FindFirstChild("PlayerGui")
                    local MainLarvaeui = PlayerGui and PlayerGui:FindFirstChild("MainLarvaeui")
                    local Frame = MainLarvaeui and MainLarvaeui:FindFirstChild("Frame")
                    local InnerFrame = Frame and Frame:FindFirstChild("Frame")
                    local Play = InnerFrame and InnerFrame:FindFirstChild("Play")
                    local Event = Play and Play:FindFirstChild("ForcePlay")

                    if Event then
                        Event:FireServer("FOODNOW!")
                    end

                    task.wait(0.0001)
                end
            end)
        end
    end
})

-- ESP GREEN TEAM

local EspGreen = false

EspTab:CreateToggle({
    Name = "Esp Green Team",
    CurrentValue = false,
    Callback = function(Value)
        EspGreen = Value
    end
})

-- ESP GREEN TEAM SCRIPT
local function GreenESP(Target)
    if not EspGreen then return end
    if not Target.Team then return end
    if not string.find(string.lower(Target.Team.Name), "green", 1, true) then return end

    local Character = Target.Character
    if not Character then return end

    local Highlight = Character:FindFirstChild("ZynzGreenESP")

    if not Highlight then
        Highlight = Instance.new("Highlight")
        Highlight.Name = "ZynzGreenESP"
        Highlight.Parent = Character
    end

    Highlight.FillColor = Color3.fromRGB(0, 255, 0)
    Highlight.OutlineColor = Color3.fromRGB(0, 255, 0)
end

