--// ZYNZ LIBRARY
local Zynz = loadstring(game:HttpGet(
    "https://raw.githubusercontent.com/ttheurus-art/Creator/refs/heads/main/Zynz.luau"
))()

local Window = Zynz:CreateWindow({
    Name = "NPC Position System",
    MainTabTheme = "Modern"
})

local MainTab = Window:CreateTab({Name = "Main"})

--// SERVICES
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local Player = Players.LocalPlayer
local PlayerGui = Player:WaitForChild("PlayerGui")
local AllNoobs = workspace:WaitForChild("Allnoobs")

local VirtualInputManager

pcall(function()
    VirtualInputManager = game:GetService("VirtualInputManager")
end)

--// SETTINGS
local Enabled = false
local PositionMode = "Top"
local Distance = 3
local OrbitSpeed = 5
local OrbitAngle = 0

local CurrentTarget = nil
local HeartbeatConnection = nil

--// CAMERA FIX
local function FixCamera()
    local Character = Player.Character
    if not Character then return end

    local Humanoid = Character:FindFirstChildOfClass("Humanoid")
    if not Humanoid then return end

    local Camera = workspace.CurrentCamera

    Humanoid.CameraOffset = Vector3.zero

    if Camera then
        Camera.CameraSubject = Humanoid
    end
end

Player.CharacterAdded:Connect(function()
    task.wait(0.5)
    FixCamera()
end)

--// CHARACTER
local function GetCharacter()
    local Character = Player.Character
    if not Character then return end

    local Humanoid = Character:FindFirstChildOfClass("Humanoid")
    local Root = Character:FindFirstChild("HumanoidRootPart")

    if not Humanoid or not Root then return end
    if Humanoid.Health <= 0 then return end

    return Character, Humanoid, Root
end

--// NPC ROOT
local function GetNPCRoot(NPC)
    if not NPC or not NPC.Parent then return end

    local Humanoid = NPC:FindFirstChildOfClass("Humanoid")
    if not Humanoid or Humanoid.Health <= 0 then return end

    local Root =
        NPC:FindFirstChild("HumanoidRootPart")
        or NPC.PrimaryPart
        or NPC:FindFirstChild("Torso")

    if not Root or not Root:IsA("BasePart") then return end

    return Root, Humanoid
end

--// TARGET VALIDATION
local function IsValidTarget(NPC)
    if not NPC then return false end
    if not NPC.Parent then return false end
    if not NPC:IsDescendantOf(AllNoobs) then return false end

    local Root, Humanoid = GetNPCRoot(NPC)

    return Root ~= nil and Humanoid ~= nil
end

--// FIND TARGET
local function GetTarget()
    if IsValidTarget(CurrentTarget) then
        return CurrentTarget
    end

    CurrentTarget = nil

    -- HEALER PRIORITY
    for _, NPC in ipairs(AllNoobs:GetChildren()) do
        if NPC.Name == "HealerNoob" and IsValidTarget(NPC) then
            CurrentTarget = NPC
            return NPC
        end
    end

    -- OTHER ENEMIES
    for _, NPC in ipairs(AllNoobs:GetChildren()) do
        if IsValidTarget(NPC) then
            CurrentTarget = NPC
            return NPC
        end
    end

    return nil
end

--// TELEPORT
local function TeleportTo(Root, Position)
    -- Preserve character rotation
    Root.CFrame = CFrame.new(Position) * Root.CFrame.Rotation
end

--// POSITION SYSTEM
local function UpdatePosition(DeltaTime)
    if not Enabled then return end

    local Character, Humanoid, Root = GetCharacter()
    if not Root then return end

    FixCamera()

    local NPC = GetTarget()

    -- NO ENEMY: CENTER OF MAP
    if not NPC then
        TeleportTo(Root, Vector3.new(0, 20, 0))
        return
    end

    local NPCRoot = GetNPCRoot(NPC)

    if not NPCRoot then
        CurrentTarget = nil
        return
    end

    local TargetPosition

    if PositionMode == "Top" then

        TargetPosition =
            NPCRoot.Position + Vector3.new(0, Distance, 0)

    elseif PositionMode == "Bottom" then

        TargetPosition =
            NPCRoot.Position - Vector3.new(0, Distance, 0)

    elseif PositionMode == "Orbit" then

        OrbitAngle += OrbitSpeed * DeltaTime

        local Radius = Distance

        local X = math.cos(OrbitAngle) * Radius
        local Z = math.sin(OrbitAngle) * Radius

        TargetPosition = NPCRoot.Position + Vector3.new(
            X,
            0,
            Z
        )
    end

    if TargetPosition then
        TeleportTo(Root, TargetPosition)
    end
end

--// START
local function Start()
    if HeartbeatConnection then
        HeartbeatConnection:Disconnect()
    end

    HeartbeatConnection = RunService.Heartbeat:Connect(function(DeltaTime)
        if Enabled then
            UpdatePosition(DeltaTime)
        end
    end)
end

--// STOP
local function Stop()
    if HeartbeatConnection then
        HeartbeatConnection:Disconnect()
        HeartbeatConnection = nil
    end

    CurrentTarget = nil
end

--// ORDINARY LEFT CLICK
local function LeftClick(Object)
    if not VirtualInputManager then
        return false
    end

    if not Object or not Object:IsA("GuiObject") then
        return false
    end

    local Position = Object.AbsolutePosition
    local Size = Object.AbsoluteSize

    local X = Position.X + Size.X / 2
    local Y = Position.Y + Size.Y / 2

    local Success = pcall(function()
        -- LEFT MOUSE BUTTON DOWN
        VirtualInputManager:SendMouseButtonEvent(
            X, Y, 0, true, game
        )

        task.wait(0.05)

        -- LEFT MOUSE BUTTON UP
        VirtualInputManager:SendMouseButtonEvent(
            X, Y, 0, false, game
        )
    end)

    return Success
end

--// AUTO CLICK
local function GetACTitle()
    local TouchGui = PlayerGui:FindFirstChild("TouchGui")
    local ControlFrame = TouchGui and TouchGui:FindFirstChild("TouchControlFrame")
    local JumpButton = ControlFrame and ControlFrame:FindFirstChild("JumpButton")
    local ACButton = JumpButton and JumpButton:FindFirstChild("ACButton")
    local Title = ACButton and ACButton:FindFirstChild("title")

    if not Title then
        return nil, nil
    end

    local Success, Text = pcall(function()
        return Title.Text
    end)

    if not Success then
        return nil, ACButton
    end

    return Text, ACButton
end

local function ActivateAuto()
    local Text, ACButton = GetACTitle()

    if not ACButton then return false end

    -- FIRST CLICK
    if not LeftClick(ACButton) then
        return false
    end

    task.wait(0.2)

    -- REPEAT WHILE AUTO IS OFF
    while Enabled do
        Text, ACButton = GetACTitle()

        if not ACButton or Text ~= "Auto: OFF" then
            break
        end

        if not LeftClick(ACButton) then
            break
        end

        task.wait(0.2)
    end

    return true
end

--// EQUIP LINKED SWORD
local function EquipLinkedSword()
    local BackpackGui = PlayerGui:FindFirstChild("BackpackGui")
    local BackpackFrame = BackpackGui and BackpackGui:FindFirstChild("Backpack")
    local Hotbar = BackpackFrame and BackpackFrame:FindFirstChild("Hotbar")
    local Slot = Hotbar and Hotbar:FindFirstChild("1")

    if not Slot then return false end

    while Enabled do
        local Tool = Player.Backpack:FindFirstChild("Linked Sword")

        if not Tool then
            break
        end

        if not LeftClick(Slot) then
            break
        end

        task.wait(0.2)
    end

    return true
end

--// SETUP
local function RunSetup()
    task.spawn(function()
        if not Enabled then return end

        ActivateAuto()

        if not Enabled then return end

        EquipLinkedSword()
    end)
end

--// UI
MainTab:CreateToggle({
    Name = "Enable System",
    Value = false,
    Callback = function(Value)
        Enabled = Value

        if Value then
            FixCamera()
            Start()
            RunSetup()

            Zynz:Notify({
                Name = "NPC System",
                Content = "System enabled.",
                Duration = 3
            })
        else
            Stop()
            FixCamera()

            Zynz:Notify({
                Name = "NPC System",
                Content = "System disabled.",
                Duration = 3
            })
        end
    end
})

MainTab:CreateDropdown({
    Name = "Position Mode",
    Options = {"Top", "Bottom", "Orbit"},
    CurrentOption = "Top",
    Callback = function(Value)
        if type(Value) == "table" then
            Value = Value[1]
        end

        PositionMode = Value
    end
})

MainTab:CreateSlider({
    Name = "Distance",
    Range = {0, 5},
    Value = 3,
    Increment = 1,
    Callback = function(Value)
        Distance = Value
    end
})

MainTab:CreateSlider({
    Name = "Orbit Speed",
    Range = {1, 15},
    Value = 5,
    Increment = 1,
    Callback = function(Value)
        OrbitSpeed = Value
    end
})
