--// ZYNZ LIBRARY
local Zynz = loadstring(game:HttpGet(
    "https://raw.githubusercontent.com/ttheurus-art/Creator/refs/heads/main/Zynz.luau"
))()

local Window = Zynz:CreateWindow({
    Name = "NPC Position System",
    MainTabTheme = "Modern"
})

local MainTab = Window:CreateTab({Name = "Main"})

--// SERVICES
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local Player = Players.LocalPlayer
local PlayerGui = Player:WaitForChild("PlayerGui")
local AllNoobs = workspace:WaitForChild("Allnoobs")

--// SETTINGS
local Enabled = false
local PositionMode = "Top"
local Distance = 3
local OrbitSpeed = 5
local OrbitAngle = 0

local CurrentTarget = nil
local HeartbeatConnection = nil
local SetupRunning = false

--// CAMERA FIX
local function FixCamera()
    local Character = Player.Character
    if not Character then return end

    local Humanoid = Character:FindFirstChildOfClass("Humanoid")
    if not Humanoid then return end

    Humanoid.CameraOffset = Vector3.zero

    local Camera = workspace.CurrentCamera
    if Camera then
        Camera.CameraSubject = Humanoid
    end
end

--// CHARACTER
local function GetCharacter()
    local Character = Player.Character
    if not Character then return end

    local Humanoid = Character:FindFirstChildOfClass("Humanoid")
    local Root = Character:FindFirstChild("HumanoidRootPart")

    if not Humanoid or not Root or Humanoid.Health <= 0 then
        return
    end

    return Character, Humanoid, Root
end

--// NPC ROOT
local function GetNPCRoot(NPC)
    if not NPC or not NPC.Parent then return end

    local Humanoid = NPC:FindFirstChildOfClass("Humanoid")
    if not Humanoid or Humanoid.Health <= 0 then return end

    local Root =
        NPC:FindFirstChild("HumanoidRootPart")
        or NPC.PrimaryPart
        or NPC:FindFirstChild("Torso")

    if not Root or not Root:IsA("BasePart") then
        return
    end

    return Root, Humanoid
end

--// TARGET VALIDATION
local function IsValidTarget(NPC)
    if not NPC or not NPC.Parent then return false end
    if not NPC:IsDescendantOf(AllNoobs) then return false end

    local Root, Humanoid = GetNPCRoot(NPC)

    return Root ~= nil and Humanoid ~= nil
end

--// FIND TARGET
local function GetTarget()
    if IsValidTarget(CurrentTarget) then
        return CurrentTarget
    end

    CurrentTarget = nil

    -- HEALER PRIORITY
    for _, NPC in ipairs(AllNoobs:GetChildren()) do
        if NPC.Name == "HealerNoob" and IsValidTarget(NPC) then
            CurrentTarget = NPC
            return NPC
        end
    end

    -- OTHER ENEMIES
    for _, NPC in ipairs(AllNoobs:GetChildren()) do
        if IsValidTarget(NPC) then
            CurrentTarget = NPC
            return NPC
        end
    end

    return nil
end

--// FULL 3D FACING
local function TeleportFacing(Root, Position, TargetPosition)
    local Direction = TargetPosition - Position

    if Direction.Magnitude > 0.001 then
        Root.CFrame = CFrame.lookAt(
            Position,
            TargetPosition,
            Vector3.yAxis
        )
    else
        Root.CFrame = CFrame.new(Position)
    end
end

--// POSITION SYSTEM
local function UpdatePosition(DeltaTime)
    if not Enabled then return end

    local Character, Humanoid, Root = GetCharacter()
    if not Root then return end

    FixCamera()

    local NPC = GetTarget()

    -- NO ENEMY: CENTER MAP
    if not NPC then
        Root.CFrame = CFrame.new(0, 20, 0) * Root.CFrame.Rotation
        return
    end

    local NPCRoot = GetNPCRoot(NPC)

    if not NPCRoot then
        CurrentTarget = nil
        return
    end

    local TargetPosition

    if PositionMode == "Top" then

        TargetPosition =
            NPCRoot.Position + Vector3.new(0, Distance, 0)

    elseif PositionMode == "Bottom" then

        TargetPosition =
            NPCRoot.Position - Vector3.new(0, Distance, 0)

    elseif PositionMode == "Orbit" then

        OrbitAngle += OrbitSpeed * DeltaTime

        TargetPosition = NPCRoot.Position + Vector3.new(
            math.cos(OrbitAngle) * Distance,
            0,
            math.sin(OrbitAngle) * Distance
        )
    end

    if TargetPosition then
        TeleportFacing(
            Root,
            TargetPosition,
            NPCRoot.Position
        )
    end
end

--// START
local function Start()
    if HeartbeatConnection then
        HeartbeatConnection:Disconnect()
    end

    HeartbeatConnection = RunService.Heartbeat:Connect(UpdatePosition)
end

--// STOP
local function Stop()
    if HeartbeatConnection then
        HeartbeatConnection:Disconnect()
        HeartbeatConnection = nil
    end

    CurrentTarget = nil
end

--// SCREEN COORDINATE INPUT
-- mouse1click is a mouse-coordinate fallback,
-- not a verified Android physical touch API.
local function TouchTapFallback(Object)
    if not Object or not Object:IsA("GuiObject") then
        return false
    end

    if not Object.Visible then return false end

    local Position = Object.AbsolutePosition
    local Size = Object.AbsoluteSize

    if Size.X <= 0 or Size.Y <= 0 then
        return false
    end

    local X = Position.X + Size.X / 2
    local Y = Position.Y + Size.Y / 2

    if type(mouse1click) == "function" then
        return pcall(function()
            mouse1click(X, Y)
        end)
    end

    return false
end

--// AUTO BUTTON
local function GetACButton()
    local TouchGui = PlayerGui:FindFirstChild("TouchGui")
    local ControlFrame = TouchGui and TouchGui:FindFirstChild("TouchControlFrame")
    local JumpButton = ControlFrame and ControlFrame:FindFirstChild("JumpButton")

    return JumpButton and JumpButton:FindFirstChild("ACButton")
end

local function ActivateAuto()
    local ACButton = GetACButton()

    if not ACButton then return end

    TouchTapFallback(ACButton)
    task.wait(0.2)

    while Enabled do
        ACButton = GetACButton()

        local Title = ACButton and ACButton:FindFirstChild("title")

        if not Title or Title.Text ~= "Auto: OFF" then
            break
        end

        TouchTapFallback(ACButton)
        task.wait(0.2)
    end
end

--// EQUIP LINKED SWORD
local function EquipLinkedSword()
    while Enabled do
        local Tool = Player.Backpack:FindFirstChild("Linked Sword")

        if not Tool then
            break
        end

        local BackpackGui = PlayerGui:FindFirstChild("BackpackGui")
        local BackpackFrame = BackpackGui and BackpackGui:FindFirstChild("Backpack")
        local Hotbar = BackpackFrame and BackpackFrame:FindFirstChild("Hotbar")
        local Slot = Hotbar and Hotbar:FindFirstChild("1")

        if Slot then
            TouchTapFallback(Slot)
        end

        task.wait(0.2)
    end
end

--// SETUP
local function RunSetup()
    if SetupRunning then return end

    SetupRunning = true

    task.spawn(function()
        ActivateAuto()

        if Enabled then
            EquipLinkedSword()
        end

        SetupRunning = false
    end)
end

--// RESPAWN
Player.CharacterAdded:Connect(function()
    task.wait(1)

    if not Enabled then return end

    FixCamera()
    RunSetup()
end)

--// UI
MainTab:CreateToggle({
    Name = "Enable System",
    Value = false,

    Callback = function(Value)
        Enabled = Value

        if Value then
            FixCamera()
            Start()
            RunSetup()

            Zynz:Notify({
                Name = "NPC System",
                Content = "System enabled.",
                Duration = 3
            })
        else
            Stop()

            Zynz:Notify({
                Name = "NPC System",
                Content = "System disabled.",
                Duration = 3
            })
        end
    end
})

MainTab:CreateDropdown({
    Name = "Position Mode",
    Options = {"Top", "Bottom", "Orbit"},
    CurrentOption = "Top",

    Callback = function(Value)
        if type(Value) == "table" then
            Value = Value[1]
        end

        PositionMode = Value
    end
})

MainTab:CreateSlider({
    Name = "Distance",
    Range = {0, 5},
    Value = 3,
    Increment = 1,

    Callback = function(Value)
        Distance = Value
    end
})

MainTab:CreateSlider({
    Name = "Orbit Speed",
    Range = {1, 15},
    Value = 5,
    Increment = 1,

    Callback = function(Value)
        OrbitSpeed = Value
    end
})
