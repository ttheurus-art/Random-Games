--// ZYNZ - ALL NPC MAIN CFRAME

--// SERVICES
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local Player = Players.LocalPlayer
local NPCFolder = workspace:WaitForChild("Allnoobs")

--// LOAD ZYNZ LIBRARY
local Zynz = loadstring(game:HttpGet(
    "https://raw.githubusercontent.com/ttheurus-art/Creator/refs/heads/main/Zynz.luau"
))()

--// SETTINGS
local Enabled = false
local Radius = 6
local Height = 0
local RotationOffset = 0

local MainCFrame = CFrame.new()
local RenderConnection = nil

--// GET CHARACTER ROOT
local function GetCharacterRoot()
    local Character = Player.Character
    if not Character then return nil end

    return Character:FindFirstChild("HumanoidRootPart")
end

--// GET NPC ROOT
local function GetRoot(NPC)
    return NPC:FindFirstChild("HumanoidRootPart")
        or NPC.PrimaryPart
        or NPC:FindFirstChild("Torso")
end

--// VALID NPC
local function IsValidNPC(NPC)
    if not NPC or not NPC:IsA("Model") then
        return false
    end

    local Humanoid = NPC:FindFirstChildOfClass("Humanoid")
    local Root = GetRoot(NPC)

    return Humanoid ~= nil
        and Humanoid.Health > 0
        and Root ~= nil
end

--// MAIN CFRAME
local function UpdateMainCFrame()
    local Root = GetCharacterRoot()

    if not Root then
        return false
    end

    MainCFrame = Root.CFrame
    return true
end

--// APPLY ALL NPC CFRAMES
local function ApplyAllNPCs()
    local NPCs = {}

    for _, NPC in ipairs(NPCFolder:GetChildren()) do
        if IsValidNPC(NPC) then
            table.insert(NPCs, NPC)
        end
    end

    local Total = #NPCs

    if Total == 0 then
        return
    end

    for Index, NPC in ipairs(NPCs) do
        local Root = GetRoot(NPC)

        if Root then
            local Angle =
                ((Index - 1) / Total) * math.pi * 2
                + RotationOffset

            local Offset = CFrame.new(
                math.cos(Angle) * Radius,
                Height,
                math.sin(Angle) * Radius
            )

            local TargetCFrame = MainCFrame * Offset

            -- Local visual positioning only
            Root.CFrame = CFrame.lookAt(
                TargetCFrame.Position,
                MainCFrame.Position
            )
        end
    end
end

--// START
local function Start()
    if RenderConnection then
        return
    end

    RenderConnection = RunService.RenderStepped:Connect(function()
        if not Enabled then
            return
        end

        if UpdateMainCFrame() then
            ApplyAllNPCs()
        end
    end)
end

--// STOP
local function Stop()
    Enabled = false

    if RenderConnection then
        RenderConnection:Disconnect()
        RenderConnection = nil
    end
end

--// ZYNZ WINDOW
local Window = Zynz:CreateWindow({
    Name = "NPC Main CFrame",
    MainTabTheme = "Modern"
})

local MainTab = Window:CreateTab({
    Name = "Main"
})

--// ENABLE
MainTab:CreateToggle({
    Name = "Enable All NPC CFrame",
    Value = false,

    Callback = function(Value)
        Enabled = Value

        if Value then
            Start()
        else
            Stop()
        end
    end
})

--// RADIUS
MainTab:CreateSlider({
    Name = "NPC Distance",
    Range = {1, 30},
    Value = 6,
    Increment = 1,

    Callback = function(Value)
        Radius = Value
    end
})

--// HEIGHT
MainTab:CreateSlider({
    Name = "NPC Height",
    Range = {-20, 20},
    Value = 0,
    Increment = 1,

    Callback = function(Value)
        Height = Value
    end
})

--// ROTATION
MainTab:CreateSlider({
    Name = "Rotation Offset",
    Range = {0, 360},
    Value = 0,
    Increment = 5,

    Callback = function(Value)
        RotationOffset = math.rad(Value)
    end
})

--// NOTIFICATION
Zynz:Notify({
    Name = "NPC Main CFrame",
    Content = "All NPC local CFrame system loaded.",
    Duration = 4
})

print("Zynz NPC Main CFrame loaded.")
